#!/usr/bin/env bash
set -euo pipefail

if [ "${SKIP_GITLEAKS:-}" = "1" ]; then
  echo "SKIP_GITLEAKS=1: skipping secret scan" >&2
  exit 0
fi

if ! command -v gitleaks >/dev/null 2>&1; then
  cat >&2 <<'EOF'
gitleaks not found; refusing to commit without a secret scan.
Install it (https://github.com/gitleaks/gitleaks) or bypass once with:
  SKIP_GITLEAKS=1 git commit ...
EOF
  exit 1
fi

gitleaks git --staged --redact -v
